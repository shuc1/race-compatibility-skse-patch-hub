<?xml version="1.0" encoding="utf-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="http://qconsulting.ca/fo3/ModConfig5.0.xsd">
    <moduleName>${PROJECT_TITLE}</moduleName>
    <installSteps order="Explicit">

        <installStep name="Plugin">
            <optionalFileGroups order="Explicit">
                <group name="" type="SelectAtMostOne">
                    <plugins order="Explicit">

                        <plugin name="RaceCompatibility Dummy Plugin">
                            <description>
Select this if you have mods require RaceCompatibility.
Contains Vanilla Ring/Amulet Armor Addon Fix.

1. Please disable the original RaceCompatibility mod after installation
2. Make sure you've set up RCS config files and ACTIVATED the dummy plugin.

The best way to use RCS is to clean up the custom race plugins before disabling RaceCompatibility entirely.</description>
                            <image path="fomod/images/race-compatibility.jpg" />
                            <files>
                                <folder source="plugin/race-compatibility"
                                    destination="./" priority="0" />
                            </files>
                            <typeDescriptor>
                                <dependencyType>
                                    <defaultType name="Optional" />
                                    <patterns>
                                        <pattern>
                                            <dependencies operator="And">
                                                <fileDependency
                                                    file="RaceCompatibility.esm"
                                                    state="Active" />
                                            </dependencies>
                                            <type name="Recommended" />
                                        </pattern>
                                    </patterns>
                                </dependencyType>
                            </typeDescriptor>
                        </plugin>

                        <plugin name="Vanilla Ring/Amulet Armor Addon Fix">
                            <description>
Select this if you want to patch vanilla ring/amulet armor addons.
Contained in RaceCompatibility Dummy Plugin.

Some armor addons don't use DefaultRace as the Race; instead, they use ArgonianRace and add other playable races in Additional Races.
For custom races whose armor race is typically set to DefaultRace, this will cause the ring/amulet to not occupy the equipment slot properly, allowing multiple rings/amulets to be worn at the same time.</description>
                            <image path="fomod/images/patch.png" />
                            <files>
                                <folder source="plugin/armor-addon-fix"
                                    destination="./" priority="0" />
                            </files>
                            <typeDescriptor>
                                <dependencyType>
                                    <defaultType name="Optional" />
                                    <patterns>
                                        <pattern>
                                            <dependencies operator="And">
                                                <fileDependency
                                                    file="Race Compatibility Vanilla Armor Addon Fix.esp"
                                                    state="Active" />
                                            </dependencies>
                                            <type name="Recommended" />
                                        </pattern>
                                    </patterns>
                                </dependencyType>
                            </typeDescriptor>
                        </plugin>

                    </plugins>
                </group>
            </optionalFileGroups>
        </installStep>

        <installStep name="Vampire">
            <optionalFileGroups order="Explicit">
                <group name="Vampire Lord Transform" type="SelectAtMostOne">
                    <plugins order="Explicit">
                        <plugin name="Dawnguard Vampire Lord Transform Script Fix">
                            <description>
Select this if you want to replace the Dawnguard script DLC1VampireTransformVisual.psc.

The only function of this patch is to store the player's race every time they change to vampire lord, in case players have changed their races after the first transformation.

If you are not going to do that, or if you have other mods that rewrite the same script, you probably DON'T need this.</description>
                            <image path="fomod/images/patch.png" />
                            <files>
                                <folder
                                    source="script/vampire/dawnguard"
                                    destination="./" priority="-1" />
                            </files>
                            <typeDescriptor>
                                <type name="Optional" />
                            </typeDescriptor>
                        </plugin>
                    </plugins>
                </group>

                <group name="Vampire Transform" type="SelectAtMostOne">
                    <plugins order="Explicit">

                        <plugin name="USSEP v${USSEP_VERSION}">
                            <description>Select this if you are using Unofficial Skyrim Special Edition Patch - USSEP</description>
                            <image path="fomod/images/ussep.jpg" />
                            <files>
                                <folder source="script/vampire/ussep"
                                    destination="./" priority="0" />
                            </files>
                            <typeDescriptor>
                                <dependencyType>
                                    <defaultType name="Optional" />
                                    <patterns>
                                        <pattern>
                                            <dependencies operator="And">
                                                <fileDependency
                                                    file="unofficial skyrim special edition patch.esp"
                                                    state="Active" />
                                            </dependencies>
                                            <type name="Recommended" />
                                        </pattern>
                                    </patterns>
                                </dependencyType>
                            </typeDescriptor>
                        </plugin>

                        <plugin name="Better Vampires v${BETTER_VAMPIRES_VERSION}">
                            <description>Select this if you are using Better Vampires</description>
                            <image path="fomod/images/better-vampires.png" />
                            <files>
                                <folder source="script/vampire/better-vampires"
                                    destination="./" priority="0" />
                            </files>
                            <typeDescriptor>
                                <dependencyType>
                                    <defaultType name="Optional" />
                                    <patterns>
                                        <pattern>
                                            <dependencies operator="And">
                                                <fileDependency
                                                    file="Better Vampires.esp"
                                                    state="Active" />
                                            </dependencies>
                                            <type name="Recommended" />
                                        </pattern>
                                    </patterns>
                                </dependencyType>
                            </typeDescriptor>
                        </plugin>

                        <plugin name="Scion v${SCION_VERSION}">
                            <description>Select this if you are using Scion</description>
                            <image path="fomod/images/scion.jpg" />
                            <files>
                                <folder source="script/vampire/scion"
                                    destination="./" priority="0" />
                            </files>
                            <typeDescriptor>
                                <dependencyType>
                                    <defaultType name="Optional" />
                                    <patterns>
                                        <pattern>
                                            <dependencies operator="And">
                                                <fileDependency file="Scion.esp" state="Active" />
                                            </dependencies>
                                            <type name="Recommended" />
                                        </pattern>
                                    </patterns>
                                </dependencyType>
                            </typeDescriptor>
                        </plugin>

                        <plugin name="Sacrilege v${SACRILEGE_VERSION}">
                            <description>Select this if you are using Sacrilege - Minimalistic Vampires of Skyrim</description>
                            <image path="fomod/images/sacrilege.jpg" />
                            <files>
                                <folder source="script/vampire/sacrilege"
                                    destination="./" priority="0" />
                            </files>
                            <typeDescriptor>
                                <dependencyType>
                                    <defaultType name="Optional" />
                                    <patterns>
                                        <pattern>
                                            <dependencies operator="And">
                                                <fileDependency
                                                    file="Sacrilege - Minimalistic Vampires of Skyrim.esp"
                                                    state="Active" />
                                            </dependencies>
                                            <type name="Recommended" />
                                        </pattern>
                                    </patterns>
                                </dependencyType>
                            </typeDescriptor>
                        </plugin>

                        <plugin name="Sacrosanct v${SACROSANCT_VERSION}">
                            <description>Select this if you are using Sacrosanct - Vampires of Skyrim</description>
                            <image path="fomod/images/sacrosanct.jpg" />
                            <files>
                                <folder source="script/vampire/sacrosanct"
                                    destination="./" priority="0" />
                            </files>
                            <typeDescriptor>
                                <dependencyType>
                                    <defaultType name="Optional" />
                                    <patterns>
                                        <pattern>
                                            <dependencies operator="And">
                                                <fileDependency
                                                    file="Sacrosanct - Vampires of Skyrim.esp"
                                                    state="Active" />
                                            </dependencies>
                                            <type name="Recommended" />
                                        </pattern>
                                    </patterns>
                                </dependencyType>
                            </typeDescriptor>
                        </plugin>

                        <plugin name="Immortal Blood v${IMMORTAL_BLOOD_VERSION}">
                            <description>Select this if you are using Immortal Blood - Vampire Overhaul</description>
                            <image path="fomod/images/immortal-blood.jpg" />
                            <files>
                                <folder source="script/vampire/immortal-blood"
                                    destination="./" priority="0" />
                            </files>
                            <typeDescriptor>
                                <dependencyType>
                                    <defaultType name="Optional" />
                                    <patterns>
                                        <pattern>
                                            <dependencies operator="And">
                                                <fileDependency
                                                    file="Immortal Blood.esp"
                                                    state="Active" />
                                            </dependencies>
                                            <type name="Recommended" />
                                        </pattern>
                                    </patterns>
                                </dependencyType>
                            </typeDescriptor>
                        </plugin>

                        <plugin name="Bloodlines of Tamriel v${BLOODLINES_OF_TAMRIEL_VERSION}">
                            <description>Select this if you are using Bloodlines of Tamriel - A Vampire Overhaul</description>
                            <image path="fomod/images/bloodlines-of-tamriel.jpg" />
                            <files>
                                <folder source="script/vampire/bloodlines-of-tamriel"
                                    destination="./" priority="0" />
                            </files>
                            <typeDescriptor>
                                <dependencyType>
                                    <defaultType name="Optional" />
                                    <patterns>
                                        <pattern>
                                            <dependencies operator="And">
                                                <fileDependency
                                                    file="Bloodlines of Tamriel.esp"
                                                    state="Active" />
                                            </dependencies>
                                            <type name="Recommended" />
                                        </pattern>
                                    </patterns>
                                </dependencyType>
                            </typeDescriptor>
                        </plugin>

                    </plugins>
                </group>

            </optionalFileGroups>
        </installStep>

        <installStep name="Werewolf">
            <optionalFileGroups order="Explicit">

                <group name="Werewolf Transfrom(Companions)" type="SelectAtMostOne">
                    <plugins order="Explicit">

                        <plugin name="USSEP v${USSEP_VERSION}">
                            <description>Select this if you are using Unofficial Skyrim Special Edition Patch - USSEP</description>
                            <image path="fomod/images/ussep.jpg" />
                            <files>
                                <folder source="script/werewolf/ussep"
                                    destination="./" priority="0" />
                            </files>
                            <typeDescriptor>
                                <dependencyType>
                                    <defaultType name="Optional" />
                                    <patterns>
                                        <pattern>
                                            <dependencies operator="And">
                                                <fileDependency
                                                    file="unofficial skyrim special edition patch.esp"
                                                    state="Active" />
                                            </dependencies>
                                            <type name="Recommended" />
                                        </pattern>
                                    </patterns>
                                </dependencyType>
                            </typeDescriptor>
                        </plugin>

                        <plugin name="USMP v${USMP_VERSION}">
                            <description>Select this if you are using Unofficial Skyrim Modder's Patch - USMP SE</description>
                            <image path="fomod/images/usmp.jpg" />
                            <files>
                                <folder source="script/werewolf/usmp"
                                    destination="./" priority="0" />
                            </files>
                            <typeDescriptor>
                                <dependencyType>
                                    <defaultType name="Optional" />
                                    <patterns>
                                        <pattern>
                                            <dependencies operator="And">
                                                <fileDependency
                                                    file="Unofficial Skyrim Modders Patch.esp"
                                                    state="Active" />
                                            </dependencies>
                                            <type name="Recommended" />
                                        </pattern>
                                    </patterns>
                                </dependencyType>
                            </typeDescriptor>
                        </plugin>

                        <plugin name="At Your Own Pace - Companions v${AT_YOUR_OWN_PACE_VERSION}">
                            <description>Select this if you are using At Your Own Pace - Companions</description>
                            <image path="fomod/images/at-your-own-pace.jpg" />
                            <files>
                                <folder source="script/werewolf/at-your-own-pace"
                                    destination="./" priority="0" />
                            </files>
                            <typeDescriptor>
                                <dependencyType>
                                    <defaultType name="Optional" />
                                    <patterns>
                                        <pattern>
                                            <dependencies operator="And">
                                                <fileDependency
                                                    file="At Your Own Pace - Companions.esp"
                                                    state="Active" />
                                            </dependencies>
                                            <type name="Recommended" />
                                        </pattern>
                                    </patterns>
                                </dependencyType>
                            </typeDescriptor>
                        </plugin>

                        <plugin name="Busy Follower Framework v${BUSY_FOLLOWER_FRAMEWORK_VERSION}">
                            <description>Select this if you are using Busy Follower Framework.</description>
                            <image path="fomod/images/busy-follower-framework.jpg" />
                            <files>
                                <folder source="script/werewolf/busy-follower-framework"
                                    destination="./" priority="0" />
                            </files>
                            <typeDescriptor>
                                <dependencyType>
                                    <defaultType name="Optional" />
                                    <patterns>
                                        <pattern>
                                            <dependencies operator="And">
                                                <fileDependency
                                                    file="BusyFollowerFramework.esp"
                                                    state="Active" />
                                            </dependencies>
                                            <type name="Recommended" />
                                        </pattern>
                                    </patterns>
                                </dependencyType>
                            </typeDescriptor>
                        </plugin>
                    </plugins>
                </group>
            </optionalFileGroups>
        </installStep>

        <installStep name="Miscellaneous">
            <optionalFileGroups order="Explicit">
                <group name="" type="SelectAny">
                    <plugins>
                        <plugin name="Growl v${GROWL_VERSION}">
                            <description>Select this if you are using Growl - Werebeasts of Skyrim</description>
                            <image path="fomod/images/growl.jpg" />
                            <files>
                                <folder source="script/misc/growl"
                                    destination="./" priority="0" />
                            </files>
                            <typeDescriptor>
                                <dependencyType>
                                    <defaultType name="Optional" />
                                    <patterns>
                                        <pattern>
                                            <dependencies operator="And">
                                                <fileDependency
                                                    file="Growl - Werebeasts of Skyrim.esp"
                                                    state="Active" />
                                            </dependencies>
                                            <type name="Recommended" />
                                        </pattern>
                                    </patterns>
                                </dependencyType>
                            </typeDescriptor>
                        </plugin>

                        <plugin name="USSEP v${USSEP_VERSION}">
                            <description>
Select this if you are using Unofficial Skyrim Special Edition Patch - USSEP.

Supports race proxies for DA04 blood harvesting and Imperial race perk initialization in MQ102. Can be installed alongside any vampire patch.</description>
                            <image path="fomod/images/ussep.jpg" />
                            <files>
                                <folder source="script/misc/ussep"
                                    destination="./" priority="0" />
                            </files>
                            <typeDescriptor>
                                <dependencyType>
                                    <defaultType name="Optional" />
                                    <patterns>
                                        <pattern>
                                            <dependencies operator="And">
                                                <fileDependency
                                                    file="unofficial skyrim special edition patch.esp"
                                                    state="Active" />
                                            </dependencies>
                                            <type name="Recommended" />
                                        </pattern>
                                    </patterns>
                                </dependencyType>
                            </typeDescriptor>
                        </plugin>

                        <plugin name="Whiterun without Main Quest v${WHITERUN_WITHOUT_MAIN_QUEST_VERSION}">
                            <description>Select this if you are using Whiterun without Main Quest - Civil War and Thane for Non-Dragonborn</description>
                            <image path="fomod/images/whiterun-without-main-quest.jpg" />
                            <files>
                                <!-- Same destination as script/misc/ussep (qf_mq102_0004e50d.pex,
                                     filename case matched on purpose so the installer sees one
                                     target file). Higher priority than script/misc/ussep (1),
                                     so this build of the script wins. -->
                                <folder source="script/misc/whiterun-without-main-quest"
                                    destination="./" priority="1" />
                            </files>
                            <typeDescriptor>
                                <dependencyType>
                                    <defaultType name="Optional" />
                                    <patterns>
                                        <pattern>
                                            <dependencies operator="And">
                                                <fileDependency
                                                    file="Whiterun without Main Quest.esp"
                                                    state="Active" />
                                            </dependencies>
                                            <type name="Recommended" />
                                        </pattern>
                                    </patterns>
                                </dependencyType>
                            </typeDescriptor>
                        </plugin>

                        <plugin name="Imperious v${IMPERIOUS_VERSION}">
                            <description>Select this if you are using Imperious - Races of Skyrim</description>
                            <image path="fomod/images/imperious.jpg" />
                            <files>
                                <folder source="script/misc/imperious"
                                    destination="./" priority="0" />
                            </files>
                            <typeDescriptor>
                                <dependencyType>
                                    <defaultType name="Optional" />
                                    <patterns>
                                        <pattern>
                                            <dependencies operator="And">
                                                <fileDependency
                                                    file="Imperious - Races of Skyrim.esp"
                                                    state="Active" />
                                            </dependencies>
                                            <type name="Recommended" />
                                        </pattern>
                                    </patterns>
                                </dependencyType>
                            </typeDescriptor>
                        </plugin>
                    </plugins>
                </group>
            </optionalFileGroups>
        </installStep>

    </installSteps>
</config>